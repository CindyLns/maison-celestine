
{% assign block_settings = block.settings %}

{% render 'contrast-override',
  background_color: block_settings.background_color,
  text_color: block_settings.text_color,
  section_id: block.id
%}

{%- liquid
  assign metafield_parts = block_settings.metafield_key | split: '.'
  assign namespace = metafield_parts[0]
  assign key = metafield_parts[1]

  assign template_type = template | split: '.' | first

  assign faqs = blank
  assign has_faq = false

  if template_type == 'product'
    assign faqs = product.metafields[namespace][key].value
    if faqs != blank
      assign has_faq = true
    endif
  elsif template_type == 'collection'
    assign faqs = collection.metafields[namespace][key].value
    if faqs != blank
      assign has_faq = true
    endif
  elsif template_type == 'page'
    assign faqs = page.metafields[namespace][key].value
    if faqs != blank
      assign has_faq = true
    endif
  elsif template_type == 'article'
    assign faqs = article.metafields[namespace][key].value
    if faqs != blank
      assign has_faq = true
    endif
  elsif template_type == 'index'
    assign faqs = shop.metafields[namespace][key].value
    if faqs != blank
      assign has_faq = true
    endif
  endif
-%}

<div
  {% if has_faq %}data-faq="true"{% endif %}
  class="accordion accordion--{{ block.id }} accordion--{{ block_settings.icon }} border-style spacing-style{% if block_settings.background_color != blank or block_settings.text_color != blank %} color-custom-{{ block.id }}{% endif %}{% if block_settings.background_color != blank %} accordion--custom-background{% endif %}{% if block_settings.dividers %} accordion--dividers{% endif %}"
  style="
    --summary-font-family: var(--font-{{ block_settings.type_preset }}--family);
     --summary-font-style: var(--font-{{ block_settings.type_preset }}--style);
     --summary-font-weight: var(--font-{{ block_settings.type_preset }}--weight);
     --summary-font-size: var(--font-{{ block_settings.type_preset }}--size);
     --summary-font-line-height: var(--font-{{ block_settings.type_preset }}--line-height);
     --summary-font-case: var(--font-{{ block_settings.type_preset }}--case);
    {% if block_settings.max_width == 'narrow' %}
      max-width: 32.5em;
    {% elsif block_settings.max_width == 'normal' %}
      max-width: 45em;
    {% endif %}
    {% if block_settings.max_width != 'none' %}
      margin-inline: auto;
    {% endif %}
    {% render 'spacing-style', settings: block_settings %}
    {% render 'border-override', settings: block_settings %}
    {% if block_settings.divider_color != blank %} --color-border: {{ block_settings.divider_color }};{% endif %}
  "
  {{ block.shopify_attributes }}
>
  {%- for faq in faqs -%}
    <accordion-custom
      {% if block_settings.open_first_by_default %}
        {% if forloop.first %}
          open-by-default-on-mobile
          open-by-default-on-desktop
        {% endif %}
      {% elsif block_settings.open_by_default %}
        open-by-default-on-mobile
        open-by-default-on-desktop
      {% endif %}
      >
      <details
          class="details faq-details"
          data-testid="accordion-details"
          {{ block.shopify_attributes }}
      >
          <summary class="details__header">
          {% assign image_upload = block_settings.image_upload | default: faq.image_upload %}
          {% render 'icon-or-image',
              icon: block_settings.icon_row,
              image_upload: image_upload,
              width: block_settings.width,
              class_name: 'details__icon'
          %}
          {{ faq.question }}
          <span class="svg-wrapper icon-caret icon-animated">
              {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
          <span class="svg-wrapper icon-plus">
              {{- 'icon-plus.svg' | inline_asset_content -}}
          </span>
          </summary>

          <div class="details-content">
          {{ faq.reponse | metafield_tag}}
          </div>
      </details>
    </accordion-custom>
  {%- endfor -%}

</div>

{% render 'accordion-styles' %}

