{% render 'knr-component-breadcrumb',
  settings: block.settings,
  section_id: block.id,
  block_mode: true,
  hide_home: block.settings.hide_home,
  hide_current: block.settings.hide_current,
  hide_desktop: block.settings.hide_desktop,
  hide_mobile: block.settings.hide_mobile
%}

{% schema %}
{
  "name": "t:knr.breadcrumb-bar.name",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "checkbox",
      "id": "hide_home",
      "label": "t:knr.breadcrumb-bar.settings.hide_home",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_current",
      "label": "t:knr.breadcrumb-bar.settings.hide_current",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:knr.breadcrumb-bar.settings.hide_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:knr.breadcrumb-bar.settings.hide_mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "checkbox",
      "id": "background",
      "label": "t:settings.background",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": true,
      "default": "#00000026",
      "visible_if": "{{ block.settings.background }}"
    }
  ]
}
{% endschema %}
